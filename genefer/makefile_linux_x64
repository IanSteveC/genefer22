# These packages are needed to build genefer: libgmp-dev ocl-icd-opencl-dev
# Compiler: select gcc or clang
COMP = gcc
#COMP = clang
# Comment this line if Boinc is not needed
BOINC = true

ifeq ($(COMP), gcc)
CC = g++ -std=c++17
else
CC = clang++ -std=c++17
endif
RM = rm

ROOT_DIR = ..

BIN_DIR = $(ROOT_DIR)/bin
SRC_DIR = $(ROOT_DIR)/src

OCL_INC = -I$(ROOT_DIR)/Khronos
OCL_LIB = -lOpenCL

# CUDA backend (genefercu): kernels are compiled at runtime via NVRTC; needs the CUDA toolkit.
CUDA_DIR = /usr/local/cuda
CUDA_INC = -I$(CUDA_DIR)/include
CUDA_LIB = -L$(CUDA_DIR)/lib64 -lcuda -lnvrtc -Wl,-rpath,$(CUDA_DIR)/lib64

ifdef BOINC
# BOINC source code: https://github.com/BOINC/boinc/archive/refs/tags/client_release/8.2/8.2.9.zip
# These packages are needed to build BOINC: m4 pkg-config autoconf libtool
# ./_autosetup
# ./configure --disable-server --disable-client --disable-manager
# api: make => libboinc_api.a libboinc_opencl.a
# lib: make => libboinc.a
BOINC_DIR = $(ROOT_DIR)/../boinc
BOINC_INC = -I$(BOINC_DIR) -I$(BOINC_DIR)/api -I$(BOINC_DIR)/lib
BOINC_LIB = $(BOINC_DIR)/api/libboinc_api.a $(BOINC_DIR)/lib/libboinc.a
BOINC_LIB_OCL = $(BOINC_DIR)/api/libboinc_opencl.a
endif

CFLAGS = -Wall -Wextra -Wsign-conversion
ifdef BOINC
CFLAGS += -DBOINC $(BOINC_INC)
endif
ifeq ($(COMP), gcc)
OFLAGS = -ffinite-math-only -frename-registers -fprefetch-loop-arrays
else
OFLAGS = -ffinite-math-only -ffp-contract=fast -fno-trapping-math -fno-signed-zeros
endif
FLAGS_CPU = -O3
FLAGS_GPU = -O3 -DGPU
FLAGS_GPU_CUDA = -O3 -DGPU -DCUDA

OBJS_CPU = main.o transform_sse2.o transform_sse4.o transform_avx.o transform_fma.o transform_512.o transform_i32.o
OBJS_GPU = maing.o transform_ocl.o
OBJS_GPU_CUDA = maingcu.o transform_cu.o
DEPS_COMMON = $(SRC_DIR)/transform.h $(SRC_DIR)/file.h $(SRC_DIR)/gint.h $(SRC_DIR)/pio.h $(SRC_DIR)/boinc.h
DEPS_MAIN = $(SRC_DIR)/genefer.h $(SRC_DIR)/timer.h $(DEPS_COMMON)
DEPS_TRANSFORM_CPUf64 = $(SRC_DIR)/transformCPUf64.h $(SRC_DIR)/transformCPUf64s.h $(SRC_DIR)/parallel.h $(SRC_DIR)/f64vector.h $(SRC_DIR)/f64vector_pair.h $(SRC_DIR)/simd128d.h $(SRC_DIR)/simd256d.h $(SRC_DIR)/simd512d.h $(DEPS_COMMON)
DEPS_TRANSFORM_CPUi32 = $(SRC_DIR)/transformCPUi32.h $(DEPS_COMMON)
DEPS_TRANSFORM_GPU = $(SRC_DIR)/transformGPU.h $(SRC_DIR)/ocl.h $(DEPS_COMMON)
DEPS_TRANSFORM_GPU_CUDA = $(SRC_DIR)/transformGPU.h $(SRC_DIR)/cu.h $(SRC_DIR)/cuda/kernel.h $(DEPS_COMMON)

EXEC_CPU = $(BIN_DIR)/genefer
EXEC_GPU = $(BIN_DIR)/geneferg
EXEC_GPU_CUDA = $(BIN_DIR)/genefercu

.PHONY: all cuda clean_obj rebuild

all: $(EXEC_CPU) $(EXEC_GPU)

# CUDA backend is opt-in (requires CUDA toolkit): make -f makefile_linux_x64 cuda
cuda: $(EXEC_GPU_CUDA)

clean_obj:
	$(RM) $(OBJS_CPU) $(OBJS_GPU) $(OBJS_GPU_CUDA)

rebuild: clean_obj all

main.o: $(SRC_DIR)/main.cpp $(DEPS_MAIN)
	$(CC) $(CFLAGS) $(FLAGS_CPU) -c $< -o $@

maing.o: $(SRC_DIR)/main.cpp $(DEPS_MAIN)
	$(CC) $(CFLAGS) $(FLAGS_GPU) $(OCL_INC) -c $< -o $@

transform_sse2.o: $(SRC_DIR)/transform_sse2.cpp $(DEPS_TRANSFORM_CPUf64)
	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mtune=core2 -c $< -o $@
#	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mtune=core2 -S $< -o sse2.asm

transform_sse4.o: $(SRC_DIR)/transform_sse4.cpp $(DEPS_TRANSFORM_CPUf64)
	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -msse4.1 -mtune=westmere -c $< -o $@
#	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -msse4.1 -mtune=westmere -S $< -o sse4.asm

transform_avx.o: $(SRC_DIR)/transform_avx.cpp $(DEPS_TRANSFORM_CPUf64)
	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx -mtune=skylake -c $< -o $@
#	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx -mtune=skylake -S $< -o avx.asm

transform_fma.o: $(SRC_DIR)/transform_fma.cpp $(DEPS_TRANSFORM_CPUf64)
	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx -mfma -mtune=skylake -c $< -o $@
#	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx -mfma -mtune=skylake -S $< -o fma.asm

transform_512.o: $(SRC_DIR)/transform_512.cpp $(DEPS_TRANSFORM_CPUf64)
	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx512f -mtune=skylake-avx512 -c $< -o $@
#	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx512f -mtune=skylake-avx512 -S $< -o 512.asm

transform_i32.o: $(SRC_DIR)/transform_i32.cpp $(DEPS_TRANSFORM_CPUi32)
	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx2 -c $< -o $@
#	$(CC) $(CFLAGS) $(OFLAGS) $(FLAGS_CPU) -mavx2 -S $< -o i32.asm

transform_ocl.o: $(SRC_DIR)/transform_ocl.cpp $(DEPS_TRANSFORM_GPU)
	$(CC) $(CFLAGS) $(FLAGS_GPU) $(OCL_INC) -c $< -o $@

$(EXEC_CPU): $(OBJS_CPU)
	$(CC) $(FLAGS_CPU) -static $^ -lgmp $(BOINC_LIB) -o $@

$(EXEC_GPU): $(OBJS_GPU)
	$(CC) $(FLAGS_GPU) -static-libgcc -static-libstdc++ $^ /usr/lib/x86_64-linux-gnu/libgmp.a $(BOINC_LIB) $(BOINC_LIB_OCL) $(OCL_LIB) -o $@

maingcu.o: $(SRC_DIR)/main.cpp $(DEPS_MAIN)
	$(CC) $(CFLAGS) $(FLAGS_GPU_CUDA) $(CUDA_INC) -c $< -o $@

transform_cu.o: $(SRC_DIR)/transform_cu.cpp $(DEPS_TRANSFORM_GPU_CUDA)
	$(CC) $(CFLAGS) $(FLAGS_GPU_CUDA) $(CUDA_INC) -c $< -o $@

# CUDA driver/nvrtc are dynamic-only, so this target is not fully -static (unlike geneferg).
$(EXEC_GPU_CUDA): $(OBJS_GPU_CUDA)
	$(CC) $(FLAGS_GPU_CUDA) -static-libgcc -static-libstdc++ $^ /usr/lib/x86_64-linux-gnu/libgmp.a $(BOINC_LIB) $(CUDA_LIB) -o $@
